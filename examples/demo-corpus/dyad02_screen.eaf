    <TIER LINGUISTIC_TYPE_REF="utterance" PARTICIPANT="A" ANNOTATOR="R1" TIER_ID="A_speech">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1" TIME_SLOT_REF1="ts3" TIME_SLOT_REF2="ts5">
                <ANNOTATION_VALUE>okay the next one looks like a sprinter</ANNOTATION_VALUE>
