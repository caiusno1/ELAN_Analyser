            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8" TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts79">
                <ANNOTATION_VALUE>with arms stretched out and a tilted head</ANNOTATION_VALUE>
